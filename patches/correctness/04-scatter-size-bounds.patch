From 32cae4e10a8fdeec6a20d71d48ecf130fca26a00 Mon Sep 17 00:00:00 2001
From: Grafici patch export <patch-export@localhost>
Date: Tue, 20 Oct 2026 23:04:58 +0100
Subject: [PATCH] Respect marker-size source length for scatter markers

Radius-dependent markers now stop at the minimum x/y/color/size length.
Dots consume no radius and still use all matching x/y/color samples; mixed
styles preserve those dots when only the sized marker runs out of radii.
No source is read past its declared size, including an empty radius source.

Read the marker-style string once per draw, removing repeated temporary
copies while retaining the existing style API and constant-size state.

Validation: scatter_lengths uses sources that assert on out-of-bounds reads
and verifies dots, circles, composite styles and short colors for float/FP16.
The complete plotting regression also passes with UBSan.

Regression sources and the configurable host runner live in Grafici-Test:
https://github.com/cattanimarco/Grafici-Test/blob/f922bc61317a4e84718346f90e9042bf436b04b5/tests/README.md
No test sources are bundled in this library patch.
---
 src/plotter/PlotScatter.h | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/src/plotter/PlotScatter.h b/src/plotter/PlotScatter.h
index fedb7fd..5871755 100644
--- a/src/plotter/PlotScatter.h
+++ b/src/plotter/PlotScatter.h
@@ -13,12 +13,18 @@ inline void plot_scatter(const DisplayDriverT<Scalar> &display,
 {
 	/* in case data sources have different sizes, use the smaller one */
 	auto source_size = DataSourceNormT<Scalar>::min_data_source_size(x, y, c);
+	const auto sized_count = DataSourceNormT<Scalar>::min_data_source_size(x, y, c, size);
+	const auto &styles = opts.get_scatter_style();
 
 	for (size_t idx = 0; idx < source_size; ++idx)
 	{
-		for (size_t idx_style = 0; idx_style < opts.get_scatter_style().length(); ++idx_style)
+		for (size_t idx_style = 0; idx_style < styles.length(); ++idx_style)
 		{
-			char s = opts.get_scatter_style()[idx_style];
+			char s = styles[idx_style];
+			// Dots do not consume a radius. Composite styles keep their dots
+			// when a shorter radius source has no corresponding sized marker.
+			if (s != '.' && idx >= sized_count)
+				continue;
 			if (s == '.')
 			{
 				// dot
