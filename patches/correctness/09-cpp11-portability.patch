-
-using Sample = grafici::Float16; // Change to float to restore FP32 storage.
-Sample values[] = {-2.0f, 0.5f, 1.5f, 3.0f};
-DataArrayXY<Sample> data(values, 4, {-4, 4});
+Adafruit_ILI9341 display(10, 9); // Chip select, data/command.
 Grafici plot(display);
 
-void draw_graph()
+float readings[] = {8.4f, 12.9f, 21.6f, 26.6f};
+DataArrayXY<float> data(readings, 4, {0, 30});
+
+void setup()
 {
+    display.begin();
+    display.setRotation(3);
+    plot.clear_screen();
+
     auto x = data.x();
     auto y = data.y();
-    plot.line(x, y, white);
+    plot.line(x, y, white, full_screen, plot_options.set_axis(4, 4));
 }
