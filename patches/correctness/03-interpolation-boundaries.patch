+    // M>=2 samples include both normalized endpoints. M==1 emits the first knot.
+    DataInterpolatorLT(const DataSourceNorm &x, const DataSourceNorm &y, size_t outputs)
+        : DataInterpolatorLT(x, y, outputs, size_t(-1))
+    {
+    }
+
+    const DataVector operator[](unsigned long idx) const override
+    {
+        size_t bin;
+        Compute weight;
+        if (!compute_x_bin(idx, &bin, &weight))
+            return INVALID_DATA_VECTOR;
+        const Compute x0 = _x[bin].raw(), x1 = _x[bin + 1].raw();
+        const Compute y0 = _y[bin].raw(), y1 = _y[bin + 1].raw();
+        return {{x0 * (Compute(1) - weight) + x1 * weight, _x.range()},
+                {y0 * (Compute(1) - weight) + y1 * weight, _y.range()}};
+    }
+
+    virtual DataSelect x() const { return DataSelect(*this, VectorComponents::x); }
+    virtual DataSelect y() const { return DataSelect(*this, VectorComponents::y); }
 
   protected:
-	const DataSourceNorm &_x;
-	const DataSourceNorm &_y;
-	size_t _src_size;
-	Range<size_t> _indexRange{ 0, 0 };
-
-	void compute_x_bin(const unsigned long idx, size_t *bin, Compute *norm_bin_weight) const
-	{
-		*bin = 0;
-		*norm_bin_weight = 1.0;
-
-		/* search for the normalized x bin containing the normalized idx */
-		while (*bin < _src_size - 1)
-		{
-			/* compute the normalized inter-bin range for the x source */
-			Range<Scalar> normBinRangeX = { _x[*bin].norm(), _x[*bin + 1].norm() };
-
-			/* compute the normalized index */
-			Compute normIndex = _indexRange.value_to_norm(idx);
-			/* compute the normalized position inside the bin (in case we found the right one or we are out of range)*/
-			*norm_bin_weight = normBinRangeX.value_to_norm(normIndex);
-			/* if the normalized index is inside the normalized bin range (on x), then stop */
-			if (normBinRangeX.contains(normIndex))
-			{
-				return;
-			}
-			else
-			{
-				(*bin)++;
-			}
-		}
-	}
+    using DataSource<DataVector>::_size;
+    const DataSourceNorm &_x;
+    const DataSourceNorm &_y;
+    size_t _src_size;
+
+    // A derived interpolator can reject excessive source counts before reads.
+    DataInterpolatorLT(const DataSourceNorm &x, const DataSourceNorm &y,
+                       size_t outputs, size_t max_intervals)
+        : DataSource<DataVector>{outputs}, _x{x}, _y{y},
+          _src_size{DataSourceNorm::min_data_source_size(x, y)}
+    {
+        if (_size == 0 || _src_size < 2 || _src_size - 1 > max_intervals || !valid_knots())
+            _size = 0;
+    }
+
+    bool compute_x_bin(unsigned long idx, size_t *bin, Compute *weight) const
+    {
+        if (idx >= _size || _src_size < 2)
+            return false;
+        const Compute target = _size == 1 ? _x[0].norm()
+            : static_cast<Compute>(idx) / static_cast<Compute>(_size - 1);
+        for (size_t i = 0; i < _src_size - 1; ++i)
+        {
+            const Compute left = _x[i].norm(), right = _x[i + 1].norm();
+            if (isfinite(left) && isfinite(right) && right > left && target >= left && target <= right)
+            {
+                *bin = i;
+                *weight = (target - left) / (right - left);
+                return true;
+            }
+        }
+        return false; // No extrapolation beyond the available knot pairs.
+    }
+
+  private:
+    bool valid_knots() const
+    {
+        const auto xr = _x.range(), yr = _y.range();
+        if (!isfinite(static_cast<Compute>(xr.low)) || !isfinite(static_cast<Compute>(xr.high)) ||
+            !isfinite(static_cast<Compute>(yr.low)) || !isfinite(static_cast<Compute>(yr.high)) ||
+            !(xr.high > xr.low) || yr.high < yr.low)
+            return false;
+        Compute previous_raw = 0, previous_norm = 0;
+        for (size_t i = 0; i < _src_size; ++i)
+        {
+            const auto x = _x[i], y = _y[i];
+            const Compute raw = x.raw(), norm = x.norm();
+            if (!isfinite(raw) || !isfinite(norm) || !isfinite(static_cast<Compute>(y.raw())) ||
+                (i > 0 && (!(raw > previous_raw) || !(norm > previous_norm))))
+                return false;
+            previous_raw = raw;
+            previous_norm = norm;
+        }
+        return true;
+    }
 };
 
 using DataInterpolatorL = DataInterpolatorLT<float>;
