--- a/src/data/DataInterpolatorL.h
+++ b/src/data/DataInterpolatorL.h
@@ -36,87 +36,84 @@ class DataInterpolatorLT : public DataSource<DataVectorT<Scalar>>
     using DataSourceNorm = DataSourceNormT<Scalar>;
     using DataSource<DataVector>::size;
     using DataInterpolatorL = DataInterpolatorLT<Scalar>;
-protected:
-    using DataSource<DataVector>::_size;
-  public:
